<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>美股板块追踪 + 量化交易 v2.0</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
<style>
:root {
  --bg:#0f172a; --card:#1e293b; --border:#334155;
  --text:#e2e8f0; --muted:#94a3b8; --green:#22c55e; --red:#ef4444;
  --blue:#3b82f6; --accent:#06b6d4; --gold:#f59e0b;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,'Microsoft YaHei',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;padding:16px}
.container{max-width:1600px;margin:0 auto}

/* Tabs */
.tabs{display:flex;gap:4px;margin-bottom:20px;border-bottom:2px solid var(--border)}
.tab{padding:10px 20px;cursor:pointer;border:none;background:none;color:var(--muted);font-size:14px;font-weight:600;border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .2s}
.tab:hover{color:var(--text)}
.tab.active{color:var(--accent);border-bottom-color:var(--accent)}

/* Header */
.header{display:flex;justify-content:space-between;align-items:center;padding:12px 0;margin-bottom:16px;flex-wrap:wrap;gap:8px}
.header h1{font-size:22px}
.header h1 span{color:var(--accent)}
.meta{font-size:12px;color:var(--muted)}

/* Date Navigator (NEW DESIGN) */
.date-nav{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap;user-select:none}
.date-nav .nav-group{display:flex;align-items:center;gap:6px;background:var(--card);border:1px solid var(--border);border-radius:10px;padding:4px}
.date-nav button.nav-btn{background:transparent;border:none;color:var(--text);width:34px;height:34px;border-radius:8px;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;transition:all .15s}
.date-nav button.nav-btn:hover:not(:disabled){background:rgba(6,182,212,0.15);color:var(--accent)}
.date-nav button.nav-btn:active:not(:disabled){transform:scale(0.92)}
.date-nav button.nav-btn:disabled{color:var(--border);cursor:not-allowed}
.date-nav .date-display{min-width:120px;text-align:center;padding:6px 14px;font-weight:700;font-size:15px;color:var(--accent);background:rgba(6,182,212,0.08);border-radius:8px;border:1px solid rgba(6,182,212,0.2);white-space:nowrap}
.date-nav .date-display .weekday{font-size:11px;color:var(--muted);font-weight:500;margin-top:1px}
.date-nav .date-display.latest{background:rgba(34,197,94,0.08);color:var(--green);border-color:rgba(34,197,94,0.25)}
.date-nav input[type=range]{flex:1;min-width:180px;accent-color:var(--accent);height:6px;border-radius:3px;background:var(--border);cursor:pointer}
.date-nav .latest-btn{background:var(--card);border:1px solid var(--border);color:var(--text);padding:7px 14px;border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;display:flex;align-items:center;gap:5px;transition:all .15s}
.date-nav .latest-btn:hover:not(:disabled){border-color:var(--accent);color:var(--accent);background:rgba(6,182,212,0.1)}
.date-nav .latest-btn:active:not(:disabled){transform:scale(0.96)}
.date-nav .latest-btn:disabled{opacity:.4;cursor:not-allowed}
.date-nav .page-indicator{font-size:11px;color:var(--muted);min-width:50px;text-align:center}

/* Cards */
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:20px}
.card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:16px;text-align:center}
.card .lbl{font-size:11px;color:var(--muted);text-transform:uppercase;margin-bottom:6px}
.card .val{font-size:28px;font-weight:700}
.card .val.up{color:var(--red)} .card .val.down{color:var(--green)}
.card .sub{font-size:11px;color:var(--muted);margin-top:4px}

/* Category sections */
.cat-section{margin-bottom:24px}
.cat-title{font-size:16px;font-weight:700;margin-bottom:10px;padding:8px 14px;background:var(--card);border-radius:8px;border-left:3px solid var(--accent);cursor:pointer}
.cat-title:hover{background:#253349}

/* Sector grid */
.sector-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:8px;margin-bottom:8px}
.sector-item{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:12px;cursor:pointer;transition:all .2s;display:flex;justify-content:space-between;align-items:center}
.sector-item:hover{border-color:var(--accent);transform:translateY(-1px);box-shadow:0 4px 12px rgba(0,0,0,.3)}
.sector-item .sym{font-size:11px;color:var(--muted)}
.sector-item .chg{font-weight:700;font-size:14px}
.chg.up{color:var(--red)} .chg.down{color:var(--green)}

/* Modal */
.modal-overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.7);z-index:100;justify-content:center;align-items:center}
.modal-overlay.show{display:flex}
.modal{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:24px;max-width:1100px;width:98%;max-height:90vh;overflow-y:auto;position:relative}
.modal h3{font-size:20px;margin-bottom:16px}
.modal .close{position:absolute;top:12px;right:16px;background:none;border:none;color:var(--muted);font-size:24px;cursor:pointer}
.modal table{width:100%;border-collapse:collapse}
.modal th{text-align:left;padding:8px 12px;font-size:11px;color:var(--muted);border-bottom:1px solid var(--border)}
.modal td{padding:8px 12px;font-size:14px;border-bottom:1px solid rgba(255,255,255,.04)}
.modal .loading{text-align:center;padding:40px;color:var(--muted)}

/* Chart */
.chart-box{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:20px}
.chart-box h3{font-size:15px;margin-bottom:12px}
canvas{max-height:380px}

/* Quant Panel */
.quant-panel{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.quant-form{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:20px}
.quant-form label{display:block;font-size:12px;color:var(--muted);margin:10px 0 4px}
.quant-form select,.quant-form input{width:100%;padding:8px 12px;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:14px}
.quant-form button{width:100%;padding:12px;margin-top:16px;background:var(--accent);border:none;border-radius:8px;color:#fff;font-size:15px;font-weight:700;cursor:pointer}
.quant-form button:hover{opacity:.85}
.quant-result{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:20px}
.quant-result .metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.quant-result .metric{text-align:center;padding:12px;background:var(--bg);border-radius:8px}
.quant-result .metric .mv{font-size:24px;font-weight:700}
.quant-result .metric .ml{font-size:11px;color:var(--muted)}

.footer{text-align:center;padding:20px;color:var(--muted);font-size:11px;border-top:1px solid var(--border);margin-top:20px}

/* Toast notification */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--card);border:1px solid var(--border);color:var(--text);padding:10px 20px;border-radius:8px;font-size:13px;box-shadow:0 8px 24px rgba(0,0,0,.4);z-index:200;opacity:0;transition:all .3s ease}
.toast.show{transform:translateX(-50%) translateY(0);opacity:1}

@media(max-width:768px){
  .quant-panel{grid-template-columns:1fr}
  .sector-grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
  .date-nav .page-indicator{display:none}
  .date-nav input[type=range]{order:1;width:100%;margin-top:4px}
  .date-nav .nav-group{order:0}
  .date-nav .latest-btn{order:0}
}
</style>
</head>
<body>
<div class="container">

<!-- Market Switcher -->
<div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;padding:8px 12px;background:var(--card);border:1px solid var(--border);border-radius:10px">
  <span style="font-size:12px;color:var(--muted)">市场选择:</span>
  <button id="marketUS" onclick="switchMarket('us')" style="background:var(--accent);border:none;color:#fff;padding:6px 16px;border-radius:6px;cursor:pointer;font-size:13px;font-weight:600">🇺🇸 美股</button>
  <button id="marketCN" onclick="switchMarket('cn')" style="background:transparent;border:1px solid var(--border);color:var(--muted);padding:6px 16px;border-radius:6px;cursor:pointer;font-size:13px;font-weight:600">🇨🇳 A股</button>
</div>

<!-- Tabs -->
<div class="tabs">
  <button class="tab active" onclick="switchTab('dashboard')">📊 板块追踪</button>
  <button class="tab" onclick="switchTab('bubble')">🫧 涨跌气泡图</button>
  <button class="tab" onclick="switchTab('rotation')">🔥 板块轮动</button>
  <button class="tab" onclick="switchTab('correlation')">🔗 相关性矩阵</button>
  <button class="tab" onclick="switchTab('quant')">📈 量化交易</button>
</div>

<!-- ==================== DASHBOARD TAB ==================== -->
<div id="tab-dashboard">
<div class="header">
  <div>
    <h1>🇺🇸 <span>美股板块追踪</span> v2.0</h1>
    <div class="meta"><span id="status"></span> | <span id="dateLabel"></span> | 共 <span id="totalSectors">-</span> 个子板块</div>
  </div>
  <div class="meta" id="updateScheduleMeta">美股 04:00/05:00 自动更新 | A股 14:30/15:30 自动更新</div>
</div>

<!-- NEW DATE NAVIGATOR -->
<div class="date-nav">
  <div class="nav-group">
    <button class="nav-btn" id="btnPrev" onclick="navigateDate(-1)" title="前一天 (←)">◀</button>
    <div class="date-display latest" id="selectedDateLabel">
      <div>最新</div>
      <div class="weekday">实时数据</div>
    </div>
    <button class="nav-btn" id="btnNext" onclick="navigateDate(1)" title="后一天 (→)">▶</button>
  </div>

  <input type="range" id="dateSlider" min="0" max="100" value="100" oninput="onSliderChange(this.value)" title="拖动选择历史日期">

  <span class="page-indicator" id="pageIndicator"></span>

  <button class="latest-btn" id="btnLatest" onclick="navigateToLatest()" title="回到最新 (Home)">
    <span>⟲</span> 回到最新
  </button>
</div>

<div class="cards" id="macroCards" style="display:none;margin-bottom:12px"></div>

<div class="cards" id="summaryCards"></div>

<div class="chart-box">
  <h3>📊 子板块涨跌幅 Top/Bottom 15</h3>
  <canvas id="mainChart"></canvas>
</div>

<div id="categoriesContainer"></div>

<!-- Modal for sector detail -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <button class="close" onclick="closeModal()">&times;</button>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:8px">
      <h3 id="modalTitle" style="margin:0">🔍 板块详情</h3>
      <button id="compareBtn" onclick="showCompareChart()" style="background:var(--card);border:1px solid var(--border);color:var(--accent);padding:5px 12px;border-radius:6px;cursor:pointer;font-size:12px;font-weight:600">📊 对比 (0)</button>
    </div>
    <div id="modalContent" class="loading">加载中...</div>
  </div>
</div>
</div>

<!-- ==================== BUBBLE CHART TAB ==================== -->
<div id="tab-bubble" style="display:none">
<div class="header">
  <div>
    <h1>🫧 <span>板块涨跌气泡图</span></h1>
    <div class="meta"><span id="bubbleDate"></span> | 气泡大小=成交量 | 红色=涨 绿色=跌</div>
  </div>
</div>
<div class="chart-box" style="min-height:600px">
  <canvas id="bubbleChart"></canvas>
</div>
</div>

<!-- ==================== ROTATION TAB ==================== -->
<div id="tab-rotation" style="display:none">
<div class="header">
  <div>
    <h1>🔥 <span>板块轮动热力图</span></h1>
    <div class="meta">1日 / 5日 / 20日 / 60日 涨跌幅矩阵 | 红色=强 绿色=弱</div>
  </div>
</div>
<div class="chart-box" style="min-height:650px">
  <div id="rotationChart" style="width:100%;height:100%"></div>
</div>
</div>

<!-- ==================== CORRELATION TAB ==================== -->
<div id="tab-correlation" style="display:none">
<div class="header">
  <div>
    <h1>🔗 <span>板块相关性矩阵</span></h1>
    <div class="meta">基于近60日收盘价计算相关系数 | 1=完全正相关 -1=完全负相关</div>
  </div>
</div>
<div class="chart-box" style="min-height:650px">
  <div id="correlationChart" style="width:100%;height:100%"></div>
</div>
</div>

<!-- ==================== QUANT TAB ==================== -->
<div id="tab-quant" style="display:none">
<div class="header">
  <div>
    <h1>📈 <span>量化交易回测平台</span></h1>
    <div class="meta">基于历史数据的策略回测 | 仅供研究参考</div>
  </div>
</div>

<div class="quant-panel">
  <div class="quant-form">
    <h3 style="margin-bottom:12px">⚙️ 策略参数</h3>
    <label>交易标的</label>
    <input type="text" id="btSymbol" value="SPY" placeholder="SPY / QQQ / AAPL...">

    <label>策略类型</label>
    <select id="btStrategy" onchange="updateParams()">
      <option value="ma_cross">均线交叉 (MA Crossover)</option>
      <option value="rsi">RSI 均值回归</option>
      <option value="momentum">动量突破 (Momentum)</option>
      <option value="sector_rotation">行业轮动 (Sector Rotation)</option>
    </select>

    <div id="btParams"></div>

    <button onclick="runBacktest()">🚀 开始回测</button>
    <button onclick="runBacktestOptimize()" style="margin-top:8px;background:var(--card);border:1px solid var(--border);color:var(--accent)">🔍 自动寻优</button>
    <div id="optimizeStatus" style="margin-top:6px;font-size:11px;color:var(--muted)"></div>
    <div style="margin-top:8px;font-size:11px;color:var(--muted)">
      ⚠️ 回测结果不代表未来收益。数据基于近1年历史价格。
    </div>
  </div>

  <div class="quant-result" id="btResult">
    <h3 style="margin-bottom:16px">📋 回测结果</h3>
    <div class="metric-grid">
      <div class="metric"><div class="ml">总收益率</div><div class="mv" id="btTotalReturn">-</div></div>
      <div class="metric"><div class="ml">买入持有</div><div class="mv" id="btBuyHold">-</div></div>
      <div class="metric"><div class="ml">夏普比率</div><div class="mv" id="btSharpe">-</div></div>
      <div class="metric"><div class="ml">最大回撤</div><div class="mv" id="btMaxDD">-</div></div>
      <div class="metric"><div class="ml">胜率</div><div class="mv" id="btWinRate">-</div></div>
      <div class="metric"><div class="ml">交易次数</div><div class="mv" id="btTrades">-</div></div>
    </div>
    <div style="margin-top:16px;font-size:11px;color:var(--muted)" id="btMeta"></div>
  </div>
</div>

<!-- Backtest Chart -->
<div class="chart-box" style="margin-top:20px;display:none" id="btChartBox">
  <h3>📈 资金曲线 & 买卖点</h3>
  <div id="backtestChart" style="width:100%;height:380px"></div>
</div>

<!-- Backtest History -->
<div class="chart-box" style="margin-top:20px">
  <h3>📜 回测历史记录</h3>
  <table style="width:100%;border-collapse:collapse" id="btHistoryTable">
    <thead><tr>
      <th style="text-align:left;padding:8px;font-size:11px;color:var(--muted);border-bottom:1px solid var(--border)">时间</th>
      <th style="text-align:left;padding:8px;font-size:11px;color:var(--muted);border-bottom:1px solid var(--border)">标的</th>
      <th style="text-align:left;padding:8px;font-size:11px;color:var(--muted);border-bottom:1px solid var(--border)">策略</th>
      <th style="text-align:right;padding:8px;font-size:11px;color:var(--muted);border-bottom:1px solid var(--border)">收益率</th>
      <th style="text-align:right;padding:8px;font-size:11px;color:var(--muted);border-bottom:1px solid var(--border)">夏普</th>
      <th style="text-align:right;padding:8px;font-size:11px;color:var(--muted);border-bottom:1px solid var(--border)">回撤</th>
    </tr></thead>
    <tbody></tbody>
  </table>
</div>
</div>

<div class="footer">US Stock Sector Tracker v2.0 | 数据每日7:00更新 | 不构成投资建议</div>

<!-- Toast -->
<div class="toast" id="toast"></div>
</div>

<script>
// ── Tab Switching ──
function switchTab(tab) {
  document.querySelectorAll('.tab').forEach((t,i) => {
    t.classList.toggle('active', (tab==='dashboard'&&i===0)||(tab==='bubble'&&i===1)||(tab==='rotation'&&i===2)||(tab==='correlation'&&i===3)||(tab==='quant'&&i===4));
  });
  document.getElementById('tab-dashboard').style.display = tab==='dashboard'?'block':'none';
  document.getElementById('tab-bubble').style.display = tab==='bubble'?'block':'none';
  document.getElementById('tab-rotation').style.display = tab==='rotation'?'block':'none';
  document.getElementById('tab-correlation').style.display = tab==='correlation'?'block':'none';
  document.getElementById('tab-quant').style.display = tab==='quant'?'block':'none';
  if (tab==='quant') loadBacktestHistory();
  if (tab==='bubble') renderBubbleChart();
  if (tab==='rotation') renderRotationChart();
  if (tab==='correlation') renderCorrelationChart();
}

// ── Dashboard ──
let allSectors = [];
let allDates = [];
let currentDateIdx = -1; // -1 = latest (newest date not in slider)
let isLoading = false;
let market = 'us'; // 'us' or 'cn'

function switchMarket(m) {
  if (m === market) return;
  market = m;
  document.getElementById('marketUS').style.background = m==='us' ? 'var(--accent)' : 'transparent';
  document.getElementById('marketUS').style.color = m==='us' ? '#fff' : 'var(--muted)';
  document.getElementById('marketUS').style.border = m==='us' ? 'none' : '1px solid var(--border)';
  document.getElementById('marketCN').style.background = m==='cn' ? 'var(--accent)' : 'transparent';
  document.getElementById('marketCN').style.color = m==='cn' ? '#fff' : 'var(--muted)';
  document.getElementById('marketCN').style.border = m==='cn' ? 'none' : '1px solid var(--border)';
  // Update title
  document.querySelector('.header h1').innerHTML = m==='us'
    ? '🇺🇸 <span>美股板块追踪</span> v3.0'
    : '🇨🇳 <span>A股板块追踪</span> v3.0';

  // Reset state and force reload for new market
  currentDateIdx = -1;
  allDates = [];
  allSectors = [];
  updateDateNavUI();

  // Clear display to avoid showing stale data
  document.getElementById('summaryCards').innerHTML = '<div class="card"><div class="lbl">加载中...</div><div class="val">⏳</div></div>';
  document.getElementById('categoriesContainer').innerHTML = '';
  if (window._chart) { window._chart.destroy(); window._chart = null; }

  // Reload data for the selected market, then refresh current tab
  loadDates().then(async () => {
    updateDateNavUI();
    await loadDashboard();
    if (market === 'us') loadMacro(); else document.getElementById('macroCards').style.display = 'none';

    // Refresh current tab visuals after data is ready
    const activeTab = document.querySelector('.tab.active');
    if (activeTab) {
      const text = activeTab.textContent;
      if (text.includes('气泡')) renderBubbleChart();
      else if (text.includes('轮动')) renderRotationChart();
      else if (text.includes('相关')) renderCorrelationChart();
      else if (text.includes('量化')) loadBacktestHistory();
    }
  });
}

function apiBase(path) {
  return market === 'cn' ? '/api/cn' + path : '/api' + path;
}

const WEEKDAYS = ['周日','周一','周二','周三','周四','周五','周六'];

function getWeekday(dateStr) {
  try { return WEEKDAYS[new Date(dateStr).getDay()]; } catch(e) { return ''; }
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2000);
}

function setLoading(loading) {
  isLoading = loading;
  const ids = ['btnPrev','btnNext','btnLatest','dateSlider'];
  ids.forEach(id => {
    const el = document.getElementById(id);
    if (el) el.disabled = loading;
  });
}

function updateDateNavUI() {
  const labelEl = document.getElementById('selectedDateLabel');
  const slider = document.getElementById('dateSlider');
  const prevBtn = document.getElementById('btnPrev');
  const nextBtn = document.getElementById('btnNext');
  const latestBtn = document.getElementById('btnLatest');
  const indicator = document.getElementById('pageIndicator');

  const total = allDates.length;
  const atLatest = currentDateIdx === -1;

  if (atLatest) {
    labelEl.classList.add('latest');
    labelEl.innerHTML = '<div>最新</div><div class="weekday">实时数据</div>';
    slider.value = total > 0 ? total - 1 : 0;
    if (indicator) indicator.textContent = total > 0 ? `共 ${total} 个交易日` : '';
  } else {
    labelEl.classList.remove('latest');
    const date = allDates[currentDateIdx];
    const wd = getWeekday(date);
    labelEl.innerHTML = `<div>${date || ''}</div><div class="weekday">${wd}</div>`;
    slider.value = currentDateIdx;
    if (indicator) indicator.textContent = `${currentDateIdx + 1} / ${total}`;
  }

  // Disable buttons at boundaries
  prevBtn.disabled = isLoading || (!atLatest && currentDateIdx <= 0);
  nextBtn.disabled = isLoading || atLatest;
  latestBtn.disabled = isLoading || atLatest;
}

async function loadDates() {
  try {
    const resp = await fetch(apiBase('/dates'));
    allDates = (await resp.json()).reverse(); // ASC: oldest first
    if (allDates.length > 0) {
      document.getElementById('dateSlider').max = allDates.length - 1;
      document.getElementById('dateSlider').value = allDates.length - 1;
    }
  } catch(e) {}
}

function onSliderChange(val) {
  const total = allDates.length;
  const idx = parseInt(val);
  // If dragged to the very end, treat as "latest" for cleaner UX
  if (idx >= total - 1) {
    navigateToLatest();
    return;
  }
  currentDateIdx = idx;
  updateDateNavUI();
  const date = allDates[idx];
  loadDashboard(date);
}

function navigateDate(dir) {
  if (isLoading) return;
  const total = allDates.length;
  if (total === 0) return;

  if (currentDateIdx === -1) {
    // Currently at "latest" — going "前一天" (older) should go to the second newest date
    // because "最新" itself isn't in allDates, the most recent in allDates is total-1
    if (dir === -1) {
      currentDateIdx = total - 2; // jump to previous trading day
      if (currentDateIdx < 0) currentDateIdx = 0;
    } else {
      showToast('已是最新数据');
      return;
    }
  } else {
    const newIdx = currentDateIdx + dir;
    if (newIdx < 0) {
      showToast('已是最早的数据');
      return;
    }
    if (newIdx >= total) {
      // Jump back to latest
      currentDateIdx = -1;
    } else {
      currentDateIdx = newIdx;
    }
  }

  updateDateNavUI();
  const date = currentDateIdx === -1 ? null : allDates[currentDateIdx];
  loadDashboard(date);
}

function navigateToLatest() {
  if (isLoading) return;
  if (currentDateIdx === -1) {
    showToast('当前已是最新');
    return;
  }
  currentDateIdx = -1;
  updateDateNavUI();
  loadDashboard();
}

async function loadDashboard(specificDate) {
  setLoading(true);
  try {
    const url = specificDate ? apiBase('/latest?date=') + specificDate : apiBase('/latest');
    const resp = await fetch(url);
    const data = await resp.json();
    if (data.error) { document.getElementById('dateLabel').textContent = data.error; setLoading(false); return; }

    allSectors = data.sectors || [];
    const updateInfo = data.updated_at ? `更新于 ${data.updated_at}` : '';
    const nextInfo = data.next_update ? ` | 下次: ${data.next_update}` : '';
    document.getElementById('dateLabel').innerHTML = '数据日期: ' + data.date + ' <span style="color:var(--muted);font-size:11px">' + updateInfo + nextInfo + '</span>';

    if (!specificDate) {
      if (allDates.length > 0) {
        if (data.date === allDates[allDates.length - 1]) {
          currentDateIdx = -1;
        } else {
          const found = allDates.indexOf(data.date);
          currentDateIdx = found >= 0 ? found : -1;
        }
      }
      updateDateNavUI();
    }

    document.getElementById('status').innerHTML = data.fetched==='live'
      ? '<span style="color:var(--green)">● 实时</span>'
      : '<span style="color:var(--blue)">● 已缓存</span>';
    document.getElementById('totalSectors').textContent = allSectors.filter(s=>s.category!=='指数').length;

    renderSummary(allSectors);
    renderChart(allSectors);
    renderCategories(allSectors);
    if (market === 'us') loadMacro(); else document.getElementById('macroCards').style.display = 'none';
  } catch(e) { console.error(e); }
  setLoading(false);
}

function renderSummary(sectors) {
  const isCN = market === 'cn';
  const sub = sectors.filter(s => s.category !== '指数');
  const up = sub.filter(s => s.change_pct > 0).length;
  const down = sub.filter(s => s.change_pct < 0).length;
  const best = sub.length ? sub.reduce((a,b) => a.change_pct > b.change_pct ? a : b) : null;
  const worst = sub.length ? sub.reduce((a,b) => a.change_pct < b.change_pct ? a : b) : null;
  const indexStock = sectors.find(s => s.symbol === (isCN ? 'SH000001' : 'SPY'));
  const currency = isCN ? '¥' : '$';
  const indexName = isCN ? '上证指数' : '标普500';

  document.getElementById('summaryCards').innerHTML = `
    <div class="card"><div class="lbl">📈 上涨板块</div><div class="val up">${up}</div><div class="sub">/ ${sub.length} 个子板块</div></div>
    <div class="card"><div class="lbl">📉 下跌板块</div><div class="val down">${down}</div><div class="sub">占比 ${sub.length?Math.round(down/sub.length*100):0}%</div></div>
    <div class="card"><div class="lbl">🏆 最强</div><div class="val up">${best?best.change_pct.toFixed(2)+'%':'-'}</div><div class="sub">${best?best.name:''} (${best?best.symbol:''})</div></div>
    <div class="card"><div class="lbl">💔 最弱</div><div class="val down">${worst?worst.change_pct.toFixed(2)+'%':'-'}</div><div class="sub">${worst?worst.name:''} (${worst?worst.symbol:''})</div></div>
    <div class="card"><div class="lbl">📊 ${indexName}</div><div class="val ${indexStock&&indexStock.change_pct>=0?'up':'down'}">${indexStock?currency+indexStock.close.toFixed(2):'-'}</div><div class="sub">${indexStock?(indexStock.change_pct>=0?'+':'')+indexStock.change_pct.toFixed(2)+'%':''}</div></div>
  `;
}

function renderChart(sectors) {
  const sub = sectors.filter(s => s.category !== '指数').sort((a,b) => b.change_pct - a.change_pct);
  const top15 = sub.slice(0, 15);
  const bot15 = sub.slice(-15).reverse();
  const show = [...top15, ...bot15];

  const ctx = document.getElementById('mainChart').getContext('2d');
  if (window._chart) window._chart.destroy();
  window._chart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: show.map(s => s.symbol + ' ' + s.name),
      datasets: [{
        label: '涨跌幅 %',
        data: show.map(s => s.change_pct),
        backgroundColor: show.map(s => s.change_pct >= 0 ? 'rgba(239,68,68,.7)' : 'rgba(34,197,94,.7)'),
        borderRadius: 3,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      indexAxis: 'y',
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { color: 'rgba(255,255,255,.05)' }, ticks: { color: '#94a3b8', callback: v => v+'%' } },
        y: { grid: { display: false }, ticks: { color: '#94a3b8', font: { size: 10 } } }
      }
    }
  });
}

function renderCategories(sectors) {
  const sub = sectors.filter(s => s.category !== '指数');
  const cats = [...new Set(sub.map(s => s.category))];
  const watchlist = getWatchlist();

  let html = '';
  // Watchlist filter button
  if (watchlist.length > 0) {
    html += `<div style="margin-bottom:12px"><button onclick="filterWatchlist()" style="background:var(--card);border:1px solid var(--border);color:var(--accent);padding:6px 14px;border-radius:6px;cursor:pointer;font-size:13px">⭐ 我的关注 (${watchlist.length})</button> <button onclick="renderCategories(allSectors)" style="background:transparent;border:1px solid var(--border);color:var(--muted);padding:6px 14px;border-radius:6px;cursor:pointer;font-size:13px;margin-left:6px">显示全部</button></div>`;
  }
  for (const cat of cats) {
    const items = sub.filter(s => s.category === cat).sort((a,b) => b.change_pct - a.change_pct);
    html += `<div class="cat-section">
      <div class="cat-title">📂 ${cat} (${items.length}个子板块)</div>
      <div class="sector-grid">`;
    for (const s of items) {
      const cls = s.change_pct >= 0 ? 'up' : 'down';
      const sign = s.change_pct >= 0 ? '+' : '';
      const star = watchlist.includes(s.symbol) ? '⭐' : '☆';
      const inCompare = compareList.findIndex(c => c.symbol === s.symbol) >= 0;
      html += `<div class="sector-item" onclick="openSectorDetail('${s.name}')">
        <div>
          <div style="display:flex;align-items:center;gap:4px">
            <span onclick="event.stopPropagation();toggleWatch('${s.symbol}')" style="cursor:pointer;font-size:12px" title="关注/取消">${star}</span>
            <strong>${s.name}</strong>
          </div>
          <span class="sym">${s.symbol} | ${market==='cn'?'¥':'\$'}${s.close.toFixed(2)}</span>
        </div>
        <div style="text-align:right">
          <div class="chg ${cls}">${sign}${s.change_pct.toFixed(2)}%</div>
          <div onclick="event.stopPropagation();toggleCompare('${s.symbol}','${s.name}')" style="font-size:10px;color:${inCompare?'var(--accent)':'var(--muted)'};cursor:pointer;margin-top:2px">${inCompare?'✓ 已加入对比':'+ 对比'}</div>
        </div>
      </div>`;
    }
    html += `</div></div>`;
  }
  document.getElementById('categoriesContainer').innerHTML = html;
}

function filterWatchlist() {
  const list = getWatchlist();
  const filtered = allSectors.filter(s => list.includes(s.symbol));
  if (filtered.length === 0) { showToast('关注列表为空'); return; }
  renderCategories(filtered);
}

// ── Modal for Top 10 Stocks ──
async function openSectorDetail(name) {
  document.getElementById('modalOverlay').classList.add('show');
  document.getElementById('modalTitle').textContent = '🔍 ' + name + ' — 龙头股 Top 10';
  document.getElementById('modalContent').innerHTML = '<div class="loading">⏳ 加载中...</div>';

  try {
    const resp = await fetch(apiBase('/sector/') + encodeURIComponent(name));
    const data = await resp.json();
    if (!data.stocks || data.stocks.length === 0) {
      document.getElementById('modalContent').innerHTML = '<p style="color:var(--muted)">该板块暂无龙头股数据</p>';
      return;
    }
    window._sectorStocks = data.stocks;
    const currency = market === 'cn' ? '¥' : '$';
    let html = '<table><thead><tr><th>#</th><th>代码</th><th>公司</th><th>简介</th><th>最新价</th><th>涨跌</th><th>K线</th></tr></thead><tbody>';
    for (let i = 0; i < data.stocks.length; i++) {
      const s = data.stocks[i];
      const cls = s.change_pct >= 0 ? 'up' : 'down';
      const sign = s.change_pct >= 0 ? '+' : '';
      html += '<tr>' +
        '<td style="color:var(--muted)">' + (i+1) + '</td>' +
        '<td><strong>' + s.symbol + '</strong></td>' +
        '<td style="font-size:12px">' + (s.name || '-') + '</td>' +
        '<td style="font-size:11px;color:var(--muted);max-width:160px">' + (s.desc || '') + '</td>' +
        '<td>' + currency + s.close.toFixed(2) + '</td>' +
        '<td class="' + cls + '" style="font-weight:700">' + sign + s.change_pct.toFixed(2) + '%</td>' +
        '<td><button onclick="showChart(\'' + s.symbol + '\',\'' + i + '\')" style="background:var(--accent);border:none;color:#fff;padding:4px 10px;border-radius:4px;cursor:pointer;font-size:11px">📈 查看</button></td>' +
      '</tr>';
    }
    html += '</tbody></table>';
    html += '<div id="chartContainer" style="margin-top:16px;height:500px;background:var(--bg);border-radius:8px;overflow:hidden">';
    html += '<p style="text-align:center;padding-top:200px;color:var(--muted)">👆 点击上方「📈 查看」按钮查看K线图</p>';
    html += '</div>';
    document.getElementById('modalContent').innerHTML = html;
  } catch(e) {
    document.getElementById('modalContent').innerHTML = '<p style="color:var(--red)">加载失败: ' + e.message + '</p>';
  }
}

function showChart(symbol, idx) {
  const rows = document.querySelectorAll('#modalContent tbody tr');
  rows.forEach((r, i) => { r.style.background = i === parseInt(idx) ? 'rgba(6,182,212,0.15)' : ''; });

  const container = document.getElementById('chartContainer');
  container.innerHTML = '<div style="text-align:center;padding-top:200px;color:var(--muted)">⏳ 加载K线数据...</div>';

  fetch(apiBase('/stock/') + symbol + '/history')
    .then(r => r.json())
    .then(data => {
      if (data.error || !data.ohlc || data.ohlc.length < 10) {
        container.innerHTML = '<p style="text-align:center;padding-top:200px;color:var(--red)">❌ 数据不足: ' + (data.error || '少于10个交易日') + '</p>';
        return;
      }
      try {
        renderEChartsCandlestick(symbol, data.ohlc);
      } catch (err) {
        console.error('K线渲染失败:', err);
        container.innerHTML = '<p style="text-align:center;padding-top:200px;color:var(--red)">❌ K线渲染失败: ' + err.message + '</p><pre style="color:var(--muted);font-size:11px;text-align:left;padding:20px">' + err.stack + '</pre>';
      }
    })
    .catch(e => {
      container.innerHTML = '<p style="text-align:center;padding-top:200px;color:var(--red)">❌ 请求失败: ' + e.message + '</p>';
    });
}

function calcMA(data, period) {
  const result = [];
  for (let i = 0; i < data.length; i++) {
    if (i < period - 1) { result.push(null); continue; }
    let sum = 0;
    for (let j = 0; j < period; j++) sum += data[i - j][1];
    result.push(+(sum / period).toFixed(2));
  }
  return result;
}

function calcBB(data, period, mult) {
  const mid = [], upper = [], lower = [];
  for (let i = 0; i < data.length; i++) {
    if (i < period - 1) { mid.push(null); upper.push(null); lower.push(null); continue; }
    let sum = 0;
    for (let j = 0; j < period; j++) sum += data[i - j][2];
    const avg = sum / period;
    let variance = 0;
    for (let j = 0; j < period; j++) variance += Math.pow(data[i - j][2] - avg, 2);
    const std = Math.sqrt(variance / period);
    mid.push(+avg.toFixed(2)); upper.push(+(avg + mult * std).toFixed(2)); lower.push(+(avg - mult * std).toFixed(2));
  }
  return { mid, upper, lower };
}

function calcFibonacci(high, low) {
  const range = high - low;
  return { 0: +high.toFixed(2), 0.236: +(high - range*0.236).toFixed(2), 0.382: +(high - range*0.382).toFixed(2), 0.5: +(high - range*0.5).toFixed(2), 0.618: +(high - range*0.618).toFixed(2), 1: +low.toFixed(2) };
}

function calcSupportResistance(highs, lows, lookback) {
  const levels = {};
  for (let i = lookback; i < highs.length - lookback; i++) {
    let isH = true, isL = true;
    for (let j = i - lookback; j <= i + lookback; j++) {
      if (j === i) continue;
      if (highs[j] >= highs[i]) isH = false;
      if (lows[j] <= lows[i]) isL = false;
    }
    if (isH) { const p = +highs[i].toFixed(2); levels[p] = (levels[p]||0)+1; }
    if (isL) { const p = +lows[i].toFixed(2); levels[p] = (levels[p]||0)+1; }
  }
  return Object.entries(levels).filter(([,c]) => c >= 2).map(([p]) => +p).sort((a,b) => b-a);
}

function calcIchimoku(highs, lows, n) {
  const tenkan = [], kijun = [], spanA = [], spanB = [];
  for (let i = 0; i < n + 26; i++) {
    if (i >= 8 && i < n) { let h=-Infinity,l=Infinity; for(let j=i-8;j<=i;j++){h=Math.max(h,highs[j]);l=Math.min(l,lows[j]);} tenkan.push(+((h+l)/2).toFixed(2)); } else tenkan.push(null);
    if (i >= 25 && i < n) { let h=-Infinity,l=Infinity; for(let j=i-25;j<=i;j++){h=Math.max(h,highs[j]);l=Math.min(l,lows[j]);} kijun.push(+((h+l)/2).toFixed(2)); } else kijun.push(null);
    if (i >= 25 && i-26 >= 0 && tenkan[i-26] !== null && kijun[i-26] !== null) spanA.push(+((tenkan[i-26]+kijun[i-26])/2).toFixed(2)); else spanA.push(null);
    if (i >= 51 && i-26 < n) { let h=-Infinity,l=Infinity; for(let j=i-51;j<=Math.min(i-26,n-1);j++){h=Math.max(h,highs[j]);l=Math.min(l,lows[j]);} spanB.push(+((h+l)/2).toFixed(2)); } else spanB.push(null);
  }
  return { tenkan, kijun, spanA, spanB };
}

function calcMonteCarlo(lastPrice, returns, days, sims) {
  const avg = returns.reduce((a,b)=>a+b,0)/returns.length;
  const vari = returns.reduce((a,b)=>a+Math.pow(b-avg,2),0)/returns.length;
  const vol = Math.sqrt(vari);
  const results = [];
  for (let s = 0; s < sims; s++) {
    let p = lastPrice;
    for (let d = 0; d < days; d++) {
      const u1 = Math.random()||0.0001, u2 = Math.random();
      p *= Math.exp(vol * Math.sqrt(-2*Math.log(u1)) * Math.cos(2*Math.PI*u2));
    }
    results.push(p);
  }
  results.sort((a,b)=>a-b);
  return { p05:results[Math.floor(sims*0.05)], p25:results[Math.floor(sims*0.25)], p50:results[Math.floor(sims*0.50)], p75:results[Math.floor(sims*0.75)], p95:results[Math.floor(sims*0.95)] };
}

function renderEChartsCandlestick(symbol, ohlc) {
  const currency = market==='cn' ? '¥' : '$';
  const container = document.getElementById('chartContainer');
  container.innerHTML = '' +
    '<div style="display:flex;gap:8px;margin-bottom:4px;align-items:center;flex-wrap:wrap">' +
      '<span style="color:var(--accent);font-weight:700;font-size:14px">🕯️ ' + symbol + '</span>' +
      '<span style="font-size:10px;color:var(--muted)">一目均衡云 | 斐波那契 | 布林带 | 蒙特卡洛 | 支撑阻力</span>' +
    '</div>' +
    '<div id="echart-main" style="height:420px;width:100%"></div>' +
    '<div id="echart-vol" style="height:100px;width:100%"></div>' +
    '<div id="prediction-summary" style="margin-top:8px;padding:10px;background:var(--card);border-radius:8px;font-size:11px"></div>';

  const n = ohlc.length;
  const dates = ohlc.map(d => d[0]);
  const ohlcData = ohlc.map(d => [d[1], d[2], d[3], d[4]]);
  const opens = ohlc.map(d => d[1]), closes = ohlc.map(d => d[2]), lows = ohlc.map(d => d[3]), highs = ohlc.map(d => d[4]);
  const volumes = ohlc.map(d => d[5]);
  const lastPrice = closes[n-1], lastDate = dates[n-1];

  const ma5 = calcMA(ohlc, 5), ma10 = calcMA(ohlc, 10), ma20 = calcMA(ohlc, 20);
  const bb = calcBB(ohlc, 20, 2);
  const ichi = calcIchimoku(highs, lows, n);

  const fibH = Math.max(...highs.slice(-60)), fibL = Math.min(...lows.slice(-60));
  const fib = calcFibonacci(fibH, fibL);
  const fibMarkLines = Object.entries(fib).map(([r,price]) => ({ name: r==='0'?'100% '+currency+price:r==='1'?'0% '+currency+price:(+(100-+r*100)).toFixed(1)+'%', yAxis: price }));

  const sr = calcSupportResistance(highs, lows, 3).slice(0, 6);

  const logRets = []; for (let i = 1; i < n; i++) if (closes[i-1]>0) logRets.push(Math.log(closes[i]/closes[i-1]));
  const mc = calcMonteCarlo(lastPrice, logRets, 20, 1000);
  const avgRet = logRets.reduce((a,b)=>a+b,0)/logRets.length;
  const dailyVol = Math.sqrt(logRets.reduce((a,b)=>a+Math.pow(b-avgRet,2),0)/logRets.length);

  const lastD = new Date(lastDate), predDates = [];
  for (let i = 1; i <= 20; i++) { const d = new Date(lastD); d.setDate(d.getDate()+i); if (d.getDay()===0) d.setDate(d.getDate()+1); if (d.getDay()===6) d.setDate(d.getDate()+2); predDates.push(d.toISOString().slice(0,10)); }
  const allDates = [...dates, ...predDates];

  const mcP50 = [], mcP05 = [], mcP95 = [];
  for (let i = 0; i < n; i++) { mcP50.push(null); mcP05.push(null); mcP95.push(null); }
  mcP50.push(lastPrice); mcP05.push(lastPrice); mcP95.push(lastPrice);
  for (let d = 1; d <= 20; d++) {
    const drift = Math.exp(avgRet*d), vt = dailyVol*Math.sqrt(d);
    mcP50.push(+(lastPrice*drift).toFixed(2));
    mcP05.push(+(lastPrice*drift*Math.exp(-1.645*vt)).toFixed(2));
    mcP95.push(+(lastPrice*drift*Math.exp(1.645*vt)).toFixed(2));
  }

  const srMarkLines = sr.map(p => ({ name: 'S/R '+currency+p.toFixed(2), yAxis: p }));

  const mainChart = echarts.init(document.getElementById('echart-main'), 'dark');
  mainChart.setOption({
    tooltip: { trigger: 'axis', axisPointer: { type: 'cross' } },
    legend: { type: 'scroll', data: ['K线','MA5/10/20','布林带','一目云','MC50','MC90%锥'],
      textStyle: { color: '#94a3b8', fontSize: 9 }, top: 0, itemWidth: 12, itemHeight: 7 },
    grid: { left: '8%', right: '3%', top: '10%', bottom: '5%' },
    xAxis: { type: 'category', data: allDates, axisLabel: { color: '#94a3b8', fontSize: 9, formatter: v => v.slice(5) }, axisLine: { lineStyle: { color: '#334155' } } },
    yAxis: { type: 'value', scale: true, axisLabel: { color: '#94a3b8' }, splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
    series: [
      { name: '一目云', type: 'line', data: ichi.spanA, lineStyle: { opacity: 0 }, symbol: 'none', areaStyle: { color: 'rgba(239,68,68,0.06)' }, stack: 'cloud', z: 0 },
      { name: '', type: 'line', data: ichi.spanB, lineStyle: { opacity: 0 }, symbol: 'none', areaStyle: { color: 'rgba(34,197,94,0.04)' }, stack: 'cloud', z: 0 },
      { name: 'MC90%锥', type: 'line', data: mcP95, lineStyle: { width: 0.5, color: 'rgba(239,68,68,0.3)', type: 'dotted' }, symbol: 'none', z: 1, areaStyle: { color: 'rgba(239,68,68,0.03)' } },
      { name: '', type: 'line', data: mcP05, lineStyle: { width: 0.5, color: 'rgba(34,197,94,0.3)', type: 'dotted' }, symbol: 'none', z: 1 },
      { name: 'MC50', type: 'line', data: mcP50, lineStyle: { width: 2, color: '#06b6d4', type: 'dashed' }, symbol: 'none', z: 2 },
      { name: '布林带', type: 'line', data: bb.upper, lineStyle: { width: 1, color: 'rgba(245,158,11,0.4)' }, symbol: 'none', z: 1 },
      { name: '', type: 'line', data: bb.mid, lineStyle: { width: 1, color: 'rgba(245,158,11,0.6)' }, symbol: 'none', z: 1 },
      { name: '', type: 'line', data: bb.lower, lineStyle: { width: 1, color: 'rgba(245,158,11,0.4)' }, symbol: 'none', z: 1 },
      { name: 'K线', type: 'candlestick', data: ohlcData, itemStyle: { color: '#ef4444', color0: '#22c55e', borderColor: '#ef4444', borderColor0: '#22c55e' }, z: 5,
        markLine: { silent: true, symbol: 'none', lineStyle: { type: 'dashed', color: '#f59e0b', width: 0.8, opacity: 0.6 }, label: { fontSize: 9, color: '#f59e0b', formatter: p => p.name }, data: [...fibMarkLines, ...srMarkLines] } },
      { name: 'MA5/10/20', type: 'line', data: ma5, smooth: true, lineStyle: { width: 1, color: '#f59e0b' }, symbol: 'none', z: 3 },
      { name: '', type: 'line', data: ma10, smooth: true, lineStyle: { width: 1, color: '#3b82f6' }, symbol: 'none', z: 3 },
      { name: '', type: 'line', data: ma20, smooth: true, lineStyle: { width: 1, color: '#a855f7' }, symbol: 'none', z: 3 },
    ]
  });

  const volChart = echarts.init(document.getElementById('echart-vol'), 'dark');
  volChart.setOption({
    grid: { left: '8%', right: '3%', top: '5%', bottom: '5%' },
    xAxis: { type: 'category', data: dates, axisLabel: { show: false }, axisLine: { show: false }, axisTick: { show: false } },
    yAxis: { type: 'value', axisLabel: { color: '#94a3b8', fontSize: 9, formatter: v => v>1e6?(v/1e6).toFixed(0)+'M':(v/1e3).toFixed(0)+'K' }, splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
    series: [{ name: '成交量', type: 'bar', data: volumes.map((v,i) => ohlc[i][2]>=ohlc[i][1]?v:-v), itemStyle: { color: v => v>0?'rgba(239,68,68,0.6)':'rgba(34,197,94,0.6)' } }]
  });
  mainChart.group = 'stockGroup'; volChart.group = 'stockGroup'; echarts.connect('stockGroup');

  const srTxt = sr.slice(0,4).map(l=>currency+l.toFixed(2)).join(' / ');
  document.getElementById('prediction-summary').innerHTML = '' +
    '<strong>🔮 多维度预测:</strong> ' +
    '<span style="color:#06b6d4">MC中位数(20日): ' + currency + mc.p50.toFixed(2) + '</span> | ' +
    '90%置信: ' + currency + mc.p05.toFixed(2) + ' ~ ' + currency + mc.p95.toFixed(2) + ' | ' +
    '斐波那契50%: ' + currency + fib[0.5].toFixed(2) + ' | ' +
    '关键支撑/阻力: ' + srTxt + ' | ' +
    '<span style="font-size:10px;color:var(--muted)">仅供参考</span>';
}

function closeModal() {
  document.getElementById('modalOverlay').classList.remove('show');
}
document.getElementById('modalOverlay').addEventListener('click', function(e) {
  if (e.target === this) closeModal();
});

// ── Quant Backtest ──
function updateParams() {
  const strat = document.getElementById('btStrategy').value;
  let html = '';
  if (strat === 'ma_cross') {
    html = '<label>快线周期</label><input type="number" id="pFast" value="5" min="2" max="50">'
         + '<label>慢线周期</label><input type="number" id="pSlow" value="20" min="5" max="200">';
  } else if (strat === 'rsi') {
    html = '<label>RSI 周期</label><input type="number" id="pPeriod" value="14" min="5" max="50">'
         + '<label>超卖阈值</label><input type="number" id="pOversold" value="30" min="10" max="40">'
         + '<label>超买阈值</label><input type="number" id="pOverbought" value="70" min="60" max="90">';
  } else if (strat === 'momentum') {
    html = '<label>回看天数</label><input type="number" id="pLookback" value="20" min="5" max="120">';
  } else if (strat === 'sector_rotation') {
    html = '<label>动量回看天数</label><input type="number" id="pLookback" value="5" min="3" max="30">';
  }
  document.getElementById('btParams').innerHTML = html;
}

async function runBacktest() {
  const symbol = document.getElementById('btSymbol').value.toUpperCase();
  const strategy = document.getElementById('btStrategy').value;
  const params = {};

  if (strategy === 'ma_cross') {
    params.fast = parseInt(document.getElementById('pFast')?.value || 5);
    params.slow = parseInt(document.getElementById('pSlow')?.value || 20);
  } else if (strategy === 'rsi') {
    params.period = parseInt(document.getElementById('pPeriod')?.value || 14);
    params.oversold = parseInt(document.getElementById('pOversold')?.value || 30);
    params.overbought = parseInt(document.getElementById('pOverbought')?.value || 70);
  } else if (strategy === 'momentum' || strategy === 'sector_rotation') {
    params.lookback = parseInt(document.getElementById('pLookback')?.value || 20);
  }

  document.getElementById('btResult').innerHTML = '<h3>📋 回测结果</h3><p style="color:var(--muted)">⏳ 正在计算...</p>';

  try {
    const resp = await fetch(apiBase('/backtest'), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ symbol, strategy, params, market })
    });
    const data = await resp.json();
    if (data.error) {
      document.getElementById('btResult').innerHTML = '<h3>📋 回测结果</h3><p style="color:var(--red)">❌ ' + data.error + '</p>';
      return;
    }

    const cls = data.total_return >= 0 ? 'up' : 'down';
    const bhc = data.buy_hold_return >= 0 ? 'up' : 'down';
    document.getElementById('btResult').innerHTML = `
      <h3 style="margin-bottom:16px">📋 回测结果 — ${symbol} (${strategy})</h3>
      <div class="metric-grid">
        <div class="metric"><div class="ml">策略收益率</div><div class="mv ${cls}">${data.total_return>=0?'+':''}${data.total_return}%</div></div>
        <div class="metric"><div class="ml">买入持有</div><div class="mv ${bhc}">${data.buy_hold_return>=0?'+':''}${data.buy_hold_return}%</div></div>
        <div class="metric"><div class="ml">夏普比率</div><div class="mv" style="color:var(--accent)">${data.sharpe}</div></div>
        <div class="metric"><div class="ml">最大回撤</div><div class="mv" style="color:var(--red)">-${data.max_drawdown}%</div></div>
        <div class="metric"><div class="ml">胜率</div><div class="mv">${data.win_rate}%</div></div>
        <div class="metric"><div class="ml">交易次数</div><div class="mv">${data.trades}</div></div>
      </div>`;
    document.getElementById('btMeta').textContent = `参数: ${JSON.stringify(params)} | 策略跑赢买入持有: ${data.total_return > data.buy_hold_return ? '✅ 是' : '❌ 否'}`;
    loadBacktestHistory();
  } catch(e) {
    document.getElementById('btResult').innerHTML = '<h3>📋 回测结果</h3><p style="color:var(--red)">❌ 网络请求失败，请检查服务器是否运行</p><p style="font-size:11px;color:var(--muted)">' + e.message + '</p>';
  }
}

async function loadBacktestHistory() {
  try {
    const resp = await fetch(apiBase('/backtest/history?limit=10'));
    const data = await resp.json();
    let html = '';
    for (const r of data) {
      const cls = r.total_return >= 0 ? 'color:var(--red)' : 'color:var(--green)';
      html += `<tr>
        <td style="padding:6px 8px;font-size:11px;color:var(--muted);border-bottom:1px solid rgba(255,255,255,.04)">${(r.created_at||'').slice(0,16)}</td>
        <td style="padding:6px 8px;font-size:13px;border-bottom:1px solid rgba(255,255,255,.04)"><strong>${r.symbol}</strong></td>
        <td style="padding:6px 8px;font-size:12px;border-bottom:1px solid rgba(255,255,255,.04)">${r.strategy}</td>
        <td style="padding:6px 8px;font-size:13px;font-weight:700;text-align:right;border-bottom:1px solid rgba(255,255,255,.04);${cls}">${r.total_return>=0?'+':''}${r.total_return}%</td>
        <td style="padding:6px 8px;font-size:12px;text-align:right;border-bottom:1px solid rgba(255,255,255,.04)">${r.sharpe}</td>
        <td style="padding:6px 8px;font-size:12px;text-align:right;color:var(--red);border-bottom:1px solid rgba(255,255,255,.04)">-${r.max_drawdown}%</td>
      </tr>`;
    }
    document.getElementById('btHistoryTable').querySelector('tbody').innerHTML = html || '<tr><td colspan="6" style="padding:16px;color:var(--muted);text-align:center">暂无回测记录</td></tr>';
  } catch(e) {}
}

// ── Bubble Chart ──
// 五行分类：木(生发)→火(热烈)→土(承载)→金(收敛)→水(流动)
const WUXING_ORDER = [
  '科技',      // 木 - 生发创新
  '医疗健康',  // 木 - 生命成长
  '能源',      // 火 - 热烈能源
  '通信服务',  // 火 - 信息传播(离为光明)
  '工业',      // 土 - 稳定实业
  '房地产',    // 土 - 土地承载
  '消费品',    // 土 - 生活根基
  '金融',      // 金 - 财富收敛
  '基础材料',  // 金 - 金属坚硬
  '公用事业',  // 水 - 流动下行
  '全球'       // 水 - 海纳百川
];
const WUXING_META = {
  '科技':      { wu: '木', color: '#22c55e', desc: '生发·创新' },
  '医疗健康':  { wu: '木', color: '#22c55e', desc: '生长·生命' },
  '能源':      { wu: '火', color: '#ef4444', desc: '热烈·能源' },
  '通信服务':  { wu: '火', color: '#ef4444', desc: '光明·传播' },
  '工业':      { wu: '土', color: '#f59e0b', desc: '承载·制造' },
  '房地产':    { wu: '土', color: '#f59e0b', desc: '稳定·土地' },
  '消费品':    { wu: '土', color: '#f59e0b', desc: '根基·生活' },
  '金融':      { wu: '金', color: '#e2e8f0', desc: '收敛·财富' },
  '基础材料':  { wu: '金', color: '#e2e8f0', desc: '坚硬·金属' },
  '公用事业':  { wu: '水', color: '#3b82f6', desc: '流动·下行' },
  '全球':      { wu: '水', color: '#3b82f6', desc: '包容·全球' },
};

// 基于symbol的固定哈希，保证每次刷新同一板块位置不变
function stableHash(str) {
  let h = 0;
  for (let i = 0; i < str.length; i++) {
    h = ((h << 5) - h) + str.charCodeAt(i);
    h |= 0;
  }
  return (Math.abs(h) % 1000) / 1000; // 0~0.999
}

function renderBubbleChart() {
  const sub = allSectors.filter(s => s.category !== '指数');
  if (sub.length === 0) { loadDashboard(); return; }

  document.getElementById('bubbleDate').textContent = '数据日期: ' + (document.getElementById('dateLabel')?.textContent || '');

  // 动态生成分类（支持美股和A股不同的分类体系）
  const cats = [...new Set(sub.map(s => s.category))];
  const totalCats = cats.length;

  const maxVol = Math.max(...sub.map(s => s.volume || 0), 1);

  const bubbles = sub.map(s => {
    const catIdx = cats.indexOf(s.category);
    // 用基于symbol的固定偏移替代随机数，保证刷新后位置不变
    const hash = stableHash(s.symbol);
    const xJitter = (hash - 0.5) * 0.35; // ±0.175 的固定偏移
    const bubbleR = Math.max(5, Math.sqrt((s.volume || 1) / maxVol) * 40);
    return {
      x: catIdx + xJitter,
      y: s.change_pct,
      r: bubbleR,
      symbol: s.symbol,
      name: s.name,
      category: s.category,
      change: s.change_pct,
      close: s.close,
      volume: s.volume
    };
  });

  const greenBubbles = bubbles.filter(b => b.change >= 0);
  const redBubbles = bubbles.filter(b => b.change < 0);

  const ctx = document.getElementById('bubbleChart').getContext('2d');
  if (window._bubbleChart) window._bubbleChart.destroy();

  window._bubbleChart = new Chart(ctx, {
    type: 'bubble',
    data: {
      datasets: [
        {
          label: '📈 上涨板块',
          data: greenBubbles,
          backgroundColor: greenBubbles.map(() => 'rgba(239,68,68,0.7)'),
          borderColor: greenBubbles.map(() => '#ef4444'),
          borderWidth: 1.5,
        },
        {
          label: '📉 下跌板块',
          data: redBubbles,
          backgroundColor: redBubbles.map(() => 'rgba(34,197,94,0.7)'),
          borderColor: redBubbles.map(() => '#22c55e'),
          borderWidth: 1.5,
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        tooltip: {
          callbacks: {
            label: ctx => {
              const b = ctx.raw;
              const sign = b.change >= 0 ? '+' : '';
              const vol = b.volume ? (b.volume/1e6).toFixed(1)+'M' : '';
              return [
                b.symbol + ' ' + b.name + ' [' + b.category + ']',
                '涨跌: ' + sign + b.change.toFixed(2) + '%',
                '价格: ' + (market==='cn'?'¥':'$') + b.close.toFixed(2),
                '成交量: ' + vol
              ];
            }
          }
        },
        legend: { position: 'top', labels: { color: '#e2e8f0', font: { size: 14 }, usePointStyle: true, padding: 20 } }
      },
      scales: {
        x: {
          title: { display: true, text: '板块分类', color: '#94a3b8', font: { size: 13 } },
          ticks: {
            callback: v => {
              const idx = Math.round(v);
              return cats[idx] || '';
            },
            color: '#94a3b8',
            font: { size: 11, weight: 'bold' },
            maxRotation: 30,
            minRotation: 30
          },
          grid: { color: 'rgba(255,255,255,0.05)' },
          min: -0.5,
          max: totalCats - 0.5,
        },
        y: {
          title: { display: true, text: '涨跌幅 (%)', color: '#94a3b8' },
          ticks: { color: '#94a3b8', callback: v => v + '%' },
          grid: {
            color: ctx => ctx.tick.value === 0 ? 'rgba(255,255,255,0.3)' : 'rgba(255,255,255,0.05)',
            lineWidth: ctx => ctx.tick.value === 0 ? 2 : 1,
          },
        }
      }
    },
    plugins: [{
      id: 'zeroLine',
      afterDraw: chart => {
        const { ctx, scales: { x, y } } = chart;
        const yZero = y.getPixelForValue(0);
        ctx.save();

        // 涨跌分界线
        ctx.strokeStyle = 'rgba(255,255,255,0.4)';
        ctx.lineWidth = 2;
        ctx.setLineDash([8, 4]);
        ctx.beginPath();
        ctx.moveTo(x.left, yZero);
        ctx.lineTo(x.right, yZero);
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.fillStyle = '#94a3b8';
        ctx.font = '11px Microsoft YaHei';
        ctx.textAlign = 'right';
        ctx.fillText('── 涨跌分界线 ──', x.right - 10, yZero - 6);

        ctx.restore();
      }
    }]
  });
}

// ── Keyboard Shortcuts ──
document.addEventListener('keydown', function(e) {
  const tag = document.activeElement?.tagName;
  if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
  if (e.key === 'ArrowLeft') { e.preventDefault(); navigateDate(-1); }
  else if (e.key === 'ArrowRight') { e.preventDefault(); navigateDate(1); }
  else if (e.key === 'Home') { e.preventDefault(); navigateToLatest(); }
});

// ── Macro Indicators ──
async function loadMacro() {
  try {
    const resp = await fetch(apiBase('/macro'));
    const d = await resp.json();
    if (!d.vix && !d.dxy && !d.tnx) return;
    const fmt = (v, p) => {
      if (v == null) return '-';
      const chg = v - p;
      const cls = chg >= 0 ? 'up' : 'down';
      const sign = chg >= 0 ? '+' : '';
      return `<span class="${cls}">${v.toFixed(2)} ${sign}${chg.toFixed(2)}</span>`;
    };
    const volTxt = d.spy_volume_ratio ? `${d.spy_volume_ratio >= 0 ? '+' : ''}${d.spy_volume_ratio}% vs 20日均量` : '';
    document.getElementById('macroCards').innerHTML = `
      <div class="card"><div class="lbl">😰 VIX 恐慌指数</div><div class="val">${fmt(d.vix, d.vix_prev)}</div></div>
      <div class="card"><div class="lbl">💵 美元指数 DXY</div><div class="val">${fmt(d.dxy, d.dxy_prev)}</div></div>
      <div class="card"><div class="lbl">📉 10Y 美债收益率</div><div class="val">${fmt(d.tnx, d.tnx_prev)}%</div></div>
      <div class="card"><div class="lbl">📊 SPY 成交量</div><div class="val">${d.spy_volume ? (d.spy_volume/1e6).toFixed(1)+'M' : '-'}</div><div class="sub">${volTxt}</div></div>
    `;
    document.getElementById('macroCards').style.display = 'grid';
  } catch(e) {}
}

// ── Watchlist / Favorites ──
function getWatchlist() {
  try { return JSON.parse(localStorage.getItem('sector_watchlist') || '[]'); } catch(e) { return []; }
}
function toggleWatch(symbol) {
  const list = getWatchlist();
  const idx = list.indexOf(symbol);
  if (idx >= 0) list.splice(idx, 1); else list.push(symbol);
  localStorage.setItem('sector_watchlist', JSON.stringify(list));
  renderCategories(allSectors);
  showToast(idx >= 0 ? '已取消关注' : '已添加关注');
}
function isWatched(symbol) { return getWatchlist().includes(symbol); }

// ── Rotation Heatmap ──
async function renderRotationChart() {
  const el = document.getElementById('rotationChart');
  if (!el) return;
  el.innerHTML = '<div style="text-align:center;padding-top:200px;color:var(--muted)">⏳ 加载中...</div>';
  try {
    console.log('[Rotation] fetching', apiBase('/rotation'));
    const resp = await fetch(apiBase('/rotation'));
    const data = await resp.json();
    console.log('[Rotation] response', data.error || ('sectors=' + (data.sectors||[]).length));
    if (data.error) {
      el.innerHTML = '<div style="text-align:center;padding-top:200px;color:var(--muted)">📭 该市场板块轮动数据暂未生成，请稍后再试<br><span style="font-size:12px">原因: ' + data.error + '</span></div>';
      return;
    }
    const sectors = data.sectors || [];
    if (sectors.length === 0) {
      el.innerHTML = '<div style="text-align:center;padding-top:200px;color:var(--muted)">📭 暂无板块轮动数据</div>';
      return;
    }
    sectors.sort((a, b) => {
      const ca = a.category || '';
      const cb = b.category || '';
      const ci = ca.localeCompare(cb);
      if (ci !== 0) return ci;
      return (b.d60 || -999) - (a.d60 || -999);
    });
    const xLabels = ['1日', '5日', '20日', '60日'];
    const yLabels = sectors.map(s => (s.name || '') + ' (' + (s.category || '') + ')');
    const heatmapData = [];
    for (let i = 0; i < sectors.length; i++) {
      for (let j = 0; j < 4; j++) {
        const v = [sectors[i].d1, sectors[i].d5, sectors[i].d20, sectors[i].d60][j];
        const num = (v === null || v === undefined || isNaN(v)) ? null : +v.toFixed(2);
        heatmapData.push([j, i, num]);
      }
    }
    console.log('[Rotation] rendering', heatmapData.length, 'cells');
    if (window._rotChart) { window._rotChart.dispose(); window._rotChart = null; }
    const chart = echarts.init(el, 'dark');
    window._rotChart = chart;

    const showLabel = sectors.length <= 40;
    const fontSize = sectors.length <= 25 ? 13 : 11;
    const axisFontSize = sectors.length <= 25 ? 14 : 12;

    // Dynamic height: each row at least 26px
    const rowH = 26;
    const totalH = Math.max(420, sectors.length * rowH + 110);
    el.style.height = totalH + 'px';

    chart.setOption({
      tooltip: {
        position: 'top',
        backgroundColor: 'rgba(30,41,59,0.95)',
        borderColor: '#334155',
        textStyle: { fontSize: 14, color: '#e2e8f0' },
        formatter: p => {
          const v = p.data[2];
          const color = v > 0 ? '#ef4444' : v < 0 ? '#22c55e' : '#94a3b8';
          return yLabels[p.data[1]] + '<br>' + xLabels[p.data[0]] + ': ' +
            '<span style="color:' + color + ';font-weight:700">' + (v != null ? v + '%' : '无数据') + '</span>';
        }
      },
      grid: { top: 30, bottom: 80, left: 150, right: 40 },
      xAxis: {
        type: 'category', data: xLabels,
        axisLabel: { color: '#e2e8f0', fontSize: axisFontSize, fontWeight: 'bold', margin: 14 },
        axisLine: { lineStyle: { color: '#334155' } },
        splitArea: { show: true }
      },
      yAxis: {
        type: 'category', data: yLabels,
        axisLabel: { color: '#e2e8f0', fontSize: axisFontSize, margin: 12 },
        axisLine: { lineStyle: { color: '#334155' } },
        inverse: true,
        splitArea: { show: true }
      },
      visualMap: {
        min: -12, max: 12, calculable: true, orient: 'horizontal', left: 'center', bottom: 10,
        text: ['强势 +12%', '弱势 -12%'], textStyle: { color: '#e2e8f0', fontSize: 13 },
        inRange: { color: ['#22c55e', '#f59e0b', '#1e293b', '#ef4444'] },
        itemWidth: 20, itemHeight: 12
      },
      series: [{
        name: '涨跌幅', type: 'heatmap', data: heatmapData,
        label: { show: showLabel, fontSize: fontSize, fontWeight: 'bold', color: '#fff', formatter: p => p.data[2] != null ? p.data[2] + '%' : '' },
        itemStyle: { borderColor: '#1e293b', borderWidth: 1, borderRadius: 4 },
        emphasis: { itemStyle: { shadowBlur: 10, shadowColor: 'rgba(0,0,0,0.5)' } }
      }]
    });
    console.log('[Rotation] rendered ok');
  } catch(e) {
    console.error('[Rotation] error', e);
    el.innerHTML = '<div style="text-align:center;padding-top:180px;color:var(--red)">❌ 图表渲染失败: ' + e.message + '<br><span style="color:var(--muted);font-size:12px">请按 F12 打开控制台查看详细报错</span></div>';
  }
}

// ── Correlation Matrix ──
async function renderCorrelationChart() {
  const el = document.getElementById('correlationChart');
  if (!el) return;
  el.innerHTML = '<div style="text-align:center;padding-top:200px;color:var(--muted)">⏳ 加载中...</div>';
  try {
    console.log('[Correlation] fetching', apiBase('/correlation'));
    const resp = await fetch(apiBase('/correlation'));
    const data = await resp.json();
    console.log('[Correlation] response', data.error || ('names=' + (data.names||[]).length));
    if (data.error) {
      el.innerHTML = '<div style="text-align:center;padding-top:200px;color:var(--muted)">📭 该市场相关性矩阵数据暂未生成，请稍后再试<br><span style="font-size:12px">原因: ' + data.error + '</span></div>';
      return;
    }
    const names = data.names || [];
    const matrix = data.matrix || [];
    if (names.length === 0) {
      el.innerHTML = '<div style="text-align:center;padding-top:200px;color:var(--muted)">📭 暂无相关性数据</div>';
      return;
    }
    // Validate matrix dimensions
    if (!Array.isArray(matrix) || matrix.length !== names.length) {
      console.error('[Correlation] matrix dimension mismatch', matrix.length, 'vs', names.length);
      el.innerHTML = '<div style="text-align:center;padding-top:200px;color:var(--red)">❌ 数据格式错误: 矩阵维度不匹配</div>';
      return;
    }
    const heatData = [];
    for (let i = 0; i < names.length; i++) {
      if (!Array.isArray(matrix[i]) || matrix[i].length !== names.length) {
        console.error('[Correlation] matrix row invalid at', i, matrix[i]);
        el.innerHTML = '<div style="text-align:center;padding-top:200px;color:var(--red)">❌ 数据格式错误: 矩阵行数据不完整</div>';
        return;
      }
      for (let j = 0; j < names.length; j++) {
        const v = matrix[i][j];
        const num = (v === null || v === undefined || isNaN(v)) ? 0 : +v;
        heatData.push([j, i, num]);
      }
    }
    console.log('[Correlation] rendering', names.length, 'x', names.length, 'cells=', heatData.length);
    if (window._corrChart) { window._corrChart.dispose(); window._corrChart = null; }
    const chart = echarts.init(el, 'dark');
    window._corrChart = chart;

    // Adjust label visibility based on density
    const showLabel = names.length <= 35;
    const fontSize = names.length <= 20 ? 12 : (names.length <= 30 ? 10 : 9);
    const axisFontSize = names.length <= 20 ? 13 : 11;
    const rotate = names.length > 25 ? 45 : 35;

    // Dynamic height: each row at least 22px
    const cellH = 22;
    const totalH = Math.max(420, names.length * cellH + 110);
    el.style.height = totalH + 'px';

    chart.setOption({
      tooltip: {
        position: 'top',
        backgroundColor: 'rgba(30,41,59,0.95)',
        borderColor: '#334155',
        textStyle: { fontSize: 14, color: '#e2e8f0' },
        formatter: p => {
          const v = p.data[2];
          const color = v > 0 ? '#ef4444' : v < 0 ? '#22c55e' : '#94a3b8';
          return names[p.data[1]] + ' ↔ ' + names[p.data[0]] + '<br>相关系数: ' +
            '<span style="color:' + color + ';font-weight:700">' + v.toFixed(2) + '</span>';
        }
      },
      grid: { top: 30, bottom: 80, left: 140, right: 40 },
      xAxis: {
        type: 'category', data: names,
        axisLabel: { color: '#e2e8f0', fontSize: axisFontSize, fontWeight: 'bold', rotate: rotate, margin: 14 },
        axisLine: { lineStyle: { color: '#334155' } },
        splitArea: { show: true }
      },
      yAxis: {
        type: 'category', data: names,
        axisLabel: { color: '#e2e8f0', fontSize: axisFontSize, margin: 12 },
        axisLine: { lineStyle: { color: '#334155' } },
        inverse: true,
        splitArea: { show: true }
      },
      visualMap: {
        min: -1, max: 1, calculable: true, orient: 'horizontal', left: 'center', bottom: 10,
        text: ['正相关 +1', '负相关 -1'], textStyle: { color: '#e2e8f0', fontSize: 13 },
        inRange: { color: ['#22c55e', '#f59e0b', '#1e293b', '#ef4444'] },
        itemWidth: 20, itemHeight: 12
      },
      dataZoom: [
        { type: 'inside', xAxisIndex: 0, start: 0, end: 100 },
        { type: 'inside', yAxisIndex: 0, start: 0, end: 100 }
      ],
      series: [{
        name: '相关系数', type: 'heatmap', data: heatData,
        label: { show: showLabel, fontSize: fontSize, fontWeight: 'bold', color: '#fff', formatter: p => p.data[2].toFixed(2) },
        itemStyle: { borderColor: '#1e293b', borderWidth: 1, borderRadius: 4 },
        emphasis: { itemStyle: { shadowBlur: 10, shadowColor: 'rgba(0,0,0,0.5)' } }
      }]
    });
    console.log('[Correlation] rendered ok');
  } catch(e) {
    console.error('[Correlation] error', e);
    el.innerHTML = '<div style="text-align:center;padding-top:180px;color:var(--red)">❌ 图表渲染失败: ' + e.message + '<br><span style="color:var(--muted);font-size:12px">请按 F12 打开控制台查看详细报错</span></div>';
  }
}

// ── Backtest Visualization & Optimization ──
let btRawData = null;

async function runBacktest() {
  const symbol = document.getElementById('btSymbol').value.toUpperCase();
  const strategy = document.getElementById('btStrategy').value;
  const params = {};
  if (strategy === 'ma_cross') {
    params.fast = parseInt(document.getElementById('pFast')?.value || 5);
    params.slow = parseInt(document.getElementById('pSlow')?.value || 20);
  } else if (strategy === 'rsi') {
    params.period = parseInt(document.getElementById('pPeriod')?.value || 14);
    params.oversold = parseInt(document.getElementById('pOversold')?.value || 30);
    params.overbought = parseInt(document.getElementById('pOverbought')?.value || 70);
  } else if (strategy === 'momentum' || strategy === 'sector_rotation') {
    params.lookback = parseInt(document.getElementById('pLookback')?.value || 20);
  }

  document.getElementById('btResult').innerHTML = '<h3>📋 回测结果</h3><p style="color:var(--muted)">⏳ 正在计算...</p>';
  document.getElementById('btChartBox').style.display = 'none';

  try {
    const resp = await fetch(apiBase('/backtest'), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ symbol, strategy, params, market })
    });
    const data = await resp.json();
    btRawData = data;
    renderBacktestResult(data);
  } catch(e) {
    document.getElementById('btResult').innerHTML = '<h3>📋 回测结果</h3><p style="color:var(--red)">❌ 网络请求失败</p>';
  }
}

function renderBacktestResult(data) {
  if (data.error) {
    document.getElementById('btResult').innerHTML = '<h3>📋 回测结果</h3><p style="color:var(--red)">❌ ' + data.error + '</p>';
    return;
  }
  const cls = data.total_return >= 0 ? 'up' : 'down';
  const bhc = data.buy_hold_return >= 0 ? 'up' : 'down';
  document.getElementById('btResult').innerHTML = `
    <h3 style="margin-bottom:16px">📋 回测结果 — ${data.symbol} (${data.strategy})</h3>
    <div class="metric-grid">
      <div class="metric"><div class="ml">策略收益率</div><div class="mv ${cls}">${data.total_return>=0?'+':''}${data.total_return}%</div></div>
      <div class="metric"><div class="ml">买入持有</div><div class="mv ${bhc}">${data.buy_hold_return>=0?'+':''}${data.buy_hold_return}%</div></div>
      <div class="metric"><div class="ml">夏普比率</div><div class="mv" style="color:var(--accent)">${data.sharpe}</div></div>
      <div class="metric"><div class="ml">最大回撤</div><div class="mv" style="color:var(--red)">-${data.max_drawdown}%</div></div>
      <div class="metric"><div class="ml">胜率</div><div class="mv">${data.win_rate}%</div></div>
      <div class="metric"><div class="ml">交易次数</div><div class="mv">${data.trades}</div></div>
    </div>`;
  document.getElementById('btMeta').textContent = `参数: ${JSON.stringify(data.params)} | 策略跑赢买入持有: ${data.total_return > data.buy_hold_return ? '✅ 是' : '❌ 否'}`;
  document.getElementById('btChartBox').style.display = 'block';
  renderBacktestChart(data);
  loadBacktestHistory();
}

function renderBacktestChart(data) {
  const el = document.getElementById('backtestChart');
  if (!el || !data.equity_curve) return;
  const chart = echarts.init(el, 'dark');
  const dates = [];
  for (let i = 0; i < data.equity_curve.length; i++) dates.push('Day ' + (i+1));
  const buyHoldCurve = [];
  // approximate buy-hold curve normalized
  const startPrice = 100, endPrice = startPrice * (1 + data.buy_hold_return/100);
  for (let i = 0; i < data.equity_curve.length; i++) {
    buyHoldCurve.push(startPrice + (endPrice - startPrice) * (i / (data.equity_curve.length - 1)));
  }
  const tradeMarks = (data.trade_list || []).map(t => ({
    xAxis: t.index,
    label: { formatter: t.signal > 0 ? '买入' : '卖出', fontSize: 9, color: t.signal > 0 ? '#ef4444' : '#22c55e' },
    lineStyle: { color: t.signal > 0 ? '#ef4444' : '#22c55e', type: 'dashed' }
  }));
  chart.setOption({
    tooltip: { trigger: 'axis' },
    legend: { data: ['策略资金曲线', '买入持有'], textStyle: { color: '#94a3b8' } },
    grid: { left: '8%', right: '4%', top: '10%', bottom: '10%' },
    xAxis: { type: 'category', data: dates, axisLabel: { show: false }, axisLine: { lineStyle: { color: '#334155' } } },
    yAxis: { type: 'value', axisLabel: { color: '#94a3b8' }, splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
    series: [
      { name: '策略资金曲线', type: 'line', data: data.equity_curve.map(v => v * 100), smooth: true, lineStyle: { width: 2, color: '#06b6d4' }, symbol: 'none' },
      { name: '买入持有', type: 'line', data: buyHoldCurve, smooth: true, lineStyle: { width: 1.5, color: '#94a3b8', type: 'dashed' }, symbol: 'none' },
      { type: 'line', markLine: { silent: true, symbol: 'none', data: tradeMarks, lineStyle: { width: 0.8 } } }
    ]
  });
}

async function runBacktestOptimize() {
  const symbol = document.getElementById('btSymbol').value.toUpperCase();
  const strategy = document.getElementById('btStrategy').value;
  const statusEl = document.getElementById('optimizeStatus');
  statusEl.textContent = '⏳ 正在网格搜索最优参数...';

  let paramGrid = [];
  if (strategy === 'ma_cross') {
    for (let f = 3; f <= 15; f += 2)
      for (let s = 15; s <= 40; s += 5)
        if (f < s) paramGrid.push({ fast: f, slow: s });
  } else if (strategy === 'rsi') {
    for (let p = 7; p <= 21; p += 7)
      for (let o = 20; o <= 40; o += 10)
        for (let b = 60; b <= 80; b += 10)
          paramGrid.push({ period: p, oversold: o, overbought: b });
  } else if (strategy === 'momentum' || strategy === 'sector_rotation') {
    for (let l = 5; l <= 40; l += 5) paramGrid.push({ lookback: l });
  }

  let best = null;
  let tested = 0;
  for (const params of paramGrid) {
    try {
      const resp = await fetch(apiBase('/backtest'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ symbol, strategy, params, market })
      });
      const r = await resp.json();
      if (!r.error) {
        const score = r.total_return - r.max_drawdown * 0.5 + r.sharpe * 5;
        if (!best || score > best.score) best = { ...r, score, params };
      }
      tested++;
      statusEl.textContent = `⏳ 已测试 ${tested}/${paramGrid.length} 组参数...`;
    } catch(e) {}
    await new Promise(r => setTimeout(r, 120)); // rate limit
  }

  if (best) {
    statusEl.textContent = `✅ 最优参数找到！测试了 ${tested} 组`;
    // Fill params back to form
    if (strategy === 'ma_cross') {
      document.getElementById('pFast').value = best.params.fast;
      document.getElementById('pSlow').value = best.params.slow;
    } else if (strategy === 'rsi') {
      document.getElementById('pPeriod').value = best.params.period;
      document.getElementById('pOversold').value = best.params.oversold;
      document.getElementById('pOverbought').value = best.params.overbought;
    } else if (strategy === 'momentum' || strategy === 'sector_rotation') {
      document.getElementById('pLookback').value = best.params.lookback;
    }
    renderBacktestResult(best);
  } else {
    statusEl.textContent = '❌ 未找到有效参数';
  }
}

// ── Multi-Sector Comparison in Modal ──
let compareList = [];
function toggleCompare(symbol, name) {
  const idx = compareList.findIndex(c => c.symbol === symbol);
  if (idx >= 0) { compareList.splice(idx, 1); }
  else if (compareList.length < 5) { compareList.push({ symbol, name }); }
  else { showToast('最多对比5个板块'); return; }
  updateCompareBadge();
}
function updateCompareBadge() {
  const btn = document.getElementById('compareBtn');
  if (btn) btn.textContent = `📊 对比 (${compareList.length})`;
}
async function showCompareChart() {
  if (compareList.length < 2) { showToast('请至少选择2个板块对比'); return; }
  const container = document.getElementById('chartContainer');
  container.innerHTML = '<div style="text-align:center;padding-top:200px;color:var(--muted)">⏳ 加载对比数据...</div>';
  const colors = ['#06b6d4', '#f59e0b', '#22c55e', '#ef4444', '#a855f7'];
  const series = [];
  for (let i = 0; i < compareList.length; i++) {
    const c = compareList[i];
    try {
      const r = await fetch(apiBase('/stock/') + c.symbol + '/history');
      const d = await r.json();
      if (d.ohlc && d.ohlc.length > 0) {
        const base = d.ohlc[0][2]; // first close
        series.push({
          name: c.symbol + ' ' + c.name,
          type: 'line',
          data: d.ohlc.map(item => ((item[2] - base) / base * 100).toFixed(2)),
          smooth: true,
          lineStyle: { width: 2, color: colors[i % colors.length] },
          symbol: 'none'
        });
      }
    } catch(e) {}
  }
  container.innerHTML = '<div id="compareChart" style="height:420px;width:100%"></div>';
  const chart = echarts.init(document.getElementById('compareChart'), 'dark');
  chart.setOption({
    tooltip: { trigger: 'axis' },
    legend: { data: series.map(s => s.name), textStyle: { color: '#94a3b8' }, top: 0 },
    grid: { left: '8%', right: '4%', top: '12%', bottom: '10%' },
    xAxis: { type: 'category', data: series[0]?.data.map((_,i) => 'D'+i) || [], axisLabel: { show: false } },
    yAxis: { type: 'value', name: '收益率 %', axisLabel: { color: '#94a3b8', formatter: v=>v+'%' }, splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
    series
  });
}

// ── Init ──
updateParams();
loadDates().then(() => {
  updateDateNavUI();
  loadDashboard();
  loadMacro();
});
setInterval(() => {
  if (currentDateIdx === -1) loadDashboard();
}, 600000);
</script>
</body>
</html>
